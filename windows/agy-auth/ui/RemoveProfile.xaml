<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除已保存配置" Width="580" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <StackPanel Margin="28,24">
    <TextBlock Text="删除这个配置？" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="请核对要从本机账号库移除的配置。" Style="{StaticResource Muted}" Margin="0,8,0,18"/>
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16">
      <StackPanel>
        <TextBlock x:Name="ProfileEmail" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ProfileDetails" Margin="0,8,0,0" Foreground="#475569" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="CurrentNotice" Text="这是当前使用的配置。删除后，客户端仍保持当前登录。" Foreground="#9A3412" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
    <TextBlock Text="仅删除本工具保存的配置，不会注销 Google 账号或取消订阅。再次切换到它需要重新保存或授权；已有的一键切号入口将失效。" TextWrapping="Wrap" Foreground="#475569" Margin="0,16,0,22"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelRemoveButton" Content="取消" IsCancel="True" IsDefault="True" Margin="0,0,10,0"/>
      <Button x:Name="ConfirmRemoveButton" Content="确认删除配置" Foreground="#B42318" BorderBrush="#F0C4BE" Background="#FFF5F4"/>
    </StackPanel>
  </StackPanel>
</Window>
