<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="在 Edge 完成 Google 授权" Width="600" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <StackPanel Margin="28,24">
    <TextBlock Text="连接 Google 账号" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="请在 Google 页面选择以下邮箱" Style="{StaticResource Muted}" Margin="0,8,0,8"/>
    <Border Background="#EAF1FF" CornerRadius="7" Padding="14,12"><TextBlock x:Name="TargetEmail" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
    <TextBlock Text="1. 在浏览器中完成授权" Margin="0,22,0,10"/>
    <Button x:Name="OpenEdgeButton" Content="正在准备授权链接…" IsEnabled="False" HorizontalAlignment="Left"/>
    <TextBlock Text="2. 粘贴 Google 页面显示的授权码" Margin="0,22,0,10"/>
    <PasswordBox x:Name="CodeInput"/>
    <TextBlock x:Name="Instructions" Text="授权成功后会保存到账号库；随后可在主窗口选择并切换。" Style="{StaticResource Muted}" Margin="0,10,0,24"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Margin="0,0,10,0"/>
      <Button x:Name="SubmitButton" Content="完成添加" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
