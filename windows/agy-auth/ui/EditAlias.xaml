<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="修改配置别名" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <StackPanel Margin="24,20">
    <TextBlock x:Name="ProfileEmail" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="ProfileDetails" Style="{StaticResource Muted}" Margin="0,4,0,16"/>
    <Label Content="配置别名" Target="{Binding ElementName=AliasInput}" Padding="0,0,0,6"/>
    <TextBox x:Name="AliasInput"/>
    <TextBlock Text="按旧别名切换的命令或快捷方式需更新。在本窗口生成的一键入口仍然有效。" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
    <TextBlock x:Name="ValidationMessage" Foreground="#C24138" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
      <Button x:Name="SaveAliasButton" Content="保存" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
