<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 Google 账号配置" Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <StackPanel Margin="28,24">
    <TextBlock Text="添加 Google 账号" FontSize="23" FontWeight="SemiBold"/>
    <TextBlock Text="先填写配置，再到 Edge 完成 Google 授权。" Style="{StaticResource Muted}" Margin="0,7,0,22"/>
    <TextBlock Text="要登录的邮箱" Margin="0,0,0,7"/>
    <TextBox x:Name="EmailInput"/>
    <TextBlock Text="配置别名" Margin="0,16,0,7"/>
    <TextBox x:Name="AliasInput"/>
    <TextBlock Text="例如 pro 或 cloud-credit；使用英文、数字、点、下划线或短横线。" Style="{StaticResource Muted}" Margin="0,6,0,18"/>
    <CheckBox x:Name="CloudCheck" Content="使用 Cloud 按量付费模式" VerticalContentAlignment="Center"/>
    <TextBlock Text="Cloud 项目 ID" Margin="0,16,0,7"/>
    <TextBox x:Name="ProjectInput" IsEnabled="False"/>
    <TextBlock Text="Cloud 地区使用 global。赠金资格和预算需在 Google Cloud 核对。" Style="{StaticResource Muted}" Margin="0,6,0,18"/>
    <TextBlock x:Name="ValidationMessage" Foreground="#C24138" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" IsCancel="True" Margin="0,0,10,0"/>
      <Button x:Name="NextButton" Content="下一步：Google 授权" Style="{StaticResource PrimaryButton}" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
